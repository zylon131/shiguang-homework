# Copy to .env. Existing .env.minimax is also loaded server-side.
PORT=8787
HOST=0.0.0.0
APP_ORIGIN=http://localhost:5173
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
# Required in production; give privately to invited pilot institutions.
PILOT_INVITE_CODE=LOCAL-PILOT-2026
ENABLE_DEMO=true
MODEL_CONCURRENCY=3
# Production requires HTTPS, secure cookies, a strong invitation code, and ENABLE_DEMO=false.
# NODE_ENV=production
